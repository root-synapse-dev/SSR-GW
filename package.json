{
  "private": false,
  "scripts": {
    "build-client": "cross-env NODE_ENV=production webpack --config webpack/webpack.config.client.mjs",
    "build-server": "cross-env NODE_ENV=production webpack --config webpack/webpack.config.server.mjs",
    "build": "npm run clean && npm run build-client && npm run build-server",
    "dev:client": "npm run clean:client && webpack serve --config webpack/webpack.config.client.mjs",
    "dev:server": "npm run clean:server && npm run build-server && nodemon build/server/server-bundle.ts",
    "start": "node build/server/server-bundle.js",
    "format": "prettier --write \"**/*.*\"",
    "clean:client": "rimraf build/client",
    "clean:server": "rimraf build/server",
    "clean": "rimraf build"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "cross-env": "^7.0.3",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-icons": "^5.2.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.7",
    "@babel/plugin-transform-runtime": "^7.24.7",
    "@babel/preset-env": "^7.24.7",
    "@babel/preset-react": "^7.24.7",
    "@babel/preset-typescript": "^7.24.7",
    "@tabler/icons-react": "^3.6.0",
    "@types/bootstrap": "^5.2.10",
    "@types/compression": "^1.7.5",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.8",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.19",
    "babel-loader": "^9.1.3",
    "bootstrap": "^5.3.3",
    "clean-webpack-plugin": "^4.0.0",
    "clsx": "^2.1.1",
    "compression-webpack-plugin": "^11.1.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^7.0.0",
    "esbuild-loader": "^4.2.0",
    "framer-motion": "^11.2.11",
    "html-webpack-plugin": "^5.6.0",
    "image-minimizer-webpack-plugin": "^4.0.2",
    "imagemin": "^9.0.0",
    "imagemin-mozjpeg": "^10.0.0",
    "imagemin-optipng": "^8.0.0",
